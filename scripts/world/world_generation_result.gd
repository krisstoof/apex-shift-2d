extends RefCounted
class_name WorldGenerationResult

## Immutable container for the complete output of a world generation pass.
## Generated by WorldGenerator.generate_world() via from_layout().
## Used by WorldGenerationValidator, debug tools, and save/load verification.

var seed: int = 0
var generator_version: String = ""
var world_rect: Rect2 = Rect2()

var biome_regions: Array[Dictionary] = []
var terrain_counts: Dictionary = {}
var biome_coverage: Dictionary = {}
var landmark_points: Array[Dictionary] = []
var resource_zones: Array[Dictionary] = []
var creature_spawn_zones: Array[Dictionary] = []
var player_spawn_position: Vector2 = Vector2.ZERO
var debug_stats: Dictionary = {}
var generation_hash: String = ""


## Create a WorldGenerationResult from the raw layout Dictionary
## returned by WorldGenerator.generate_world().
static func from_layout(layout: Dictionary) -> WorldGenerationResult:
	var result := WorldGenerationResult.new()
	result.seed = int(layout.get("seed", 0))
	result.generator_version = str(layout.get("generator_rules_version", ""))
	result.world_rect = Rect2(layout.get("world_rect", Rect2()))
	result.biome_regions = Array(layout.get("biomes", []))
	result.resource_zones = Array(layout.get("resource_zones", []))
	result.creature_spawn_zones = Array(layout.get("creature_spawn_zones", []))
	result.landmark_points = Array(layout.get("landmarks", []))
	result.debug_stats = Dictionary(layout.get("debug", {}))
	result.terrain_counts = Dictionary(result.debug_stats.get("terrain_counts", {}))
	result.biome_coverage = Dictionary(result.debug_stats.get("biome_coverage", {}))
	result.generation_hash = WorldGenerationResult.compute_hash_from_layout(layout)
	return result


## Compute a stable hash of the key generation outputs.
## Same seed + same generator version must produce the same hash.
## Rendering settings, UI settings, and texture budgets must NOT affect this hash.
static func compute_hash_from_layout(layout: Dictionary) -> String:
	var debug := Dictionary(layout.get("debug", {}))
	# Use stable, deterministic fields only.
	# terrain_counts and biome_coverage are computed from noise — same seed = same values.
	var payload := {
		"seed": int(layout.get("seed", 0)),
		"version": str(layout.get("generator_rules_version", "")),
		"world_rect_x": float(Rect2(layout.get("world_rect", Rect2())).position.x),
		"world_rect_y": float(Rect2(layout.get("world_rect", Rect2())).position.y),
		"world_rect_w": float(Rect2(layout.get("world_rect", Rect2())).size.x),
		"world_rect_h": float(Rect2(layout.get("world_rect", Rect2())).size.y),
		"terrain_counts": Dictionary(debug.get("terrain_counts", {})),
		"biome_coverage": Dictionary(debug.get("biome_coverage", {})),
		"spawn_zone_count": Array(layout.get("creature_spawn_zones", [])).size(),
		"biome_count": Array(layout.get("biomes", [])).size(),
	}
	return str(hash(JSON.stringify(payload)))


## Return a flat Dictionary suitable for logging, debug panels, and JSON dumps.
func to_debug_dict() -> Dictionary:
	return {
		"seed": seed,
		"generator_version": generator_version,
		"world_rect": str(world_rect),
		"biome_region_count": biome_regions.size(),
		"resource_zone_count": resource_zones.size(),
		"creature_spawn_zone_count": creature_spawn_zones.size(),
		"landmark_count": landmark_points.size(),
		"terrain_counts": terrain_counts.duplicate(),
		"biome_coverage": biome_coverage.duplicate(),
		"generation_hash": generation_hash,
	}


## Serialize to a pretty-printed JSON string for file dumps and reproducibility testing.
func to_json_dump() -> String:
	return JSON.stringify(to_debug_dict(), "\t")
